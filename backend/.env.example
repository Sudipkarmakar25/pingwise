ENVIRONMENT=local
SERVER_ADDRESS=:8090
PRIMARY_DB_DSN=postgres://USER:PASSWORD@localhost:5433/pingwise?sslmode=disable
MAX_OPEN_CONNS_TO_DB=10
LOG_LEVEL=info

# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# health checks that run at the same time in the worker
CHECK_WORKERS=20

# Alert emails over SMTP. Leave SMTP_HOST empty to turn emails off.
# Gmail: smtp.gmail.com, port 587, your Gmail address, and an app password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL="Pingwise <you@gmail.com>"
# the web app's address, for the "View service" link in emails
APP_URL=http://localhost:3100
